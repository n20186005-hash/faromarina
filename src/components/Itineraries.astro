---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const it = messages.itineraries;
const audiences = it.audiences ?? [];
const routes = it.routes ?? [];
---

<section id="itineraries" class="section-shell">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{it.title}</h2>
      {it.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{it.intro}</p>}
    </div>

    <h3 class="font-semibold text-xl mb-5" style="color: var(--text-primary);">{it.audienceTitle}</h3>
    <div class="grid gap-5 md:grid-cols-3 mb-12">
      {
        audiences.map((a) => (
          <div class="rounded-2xl p-6" style="background: var(--card-bg); border: 1px solid var(--border-color);">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl" aria-hidden="true">{a.icon}</span>
              <h4 class="font-semibold" style="color: var(--text-primary);">{a.title}</h4>
            </div>
            <p class="text-sm mb-3" style="color: var(--text-secondary);">{a.body}</p>
            <ol class="space-y-2 list-decimal list-inside text-sm" style="color: var(--text-secondary);">
              {(a.steps ?? []).map((step) => <li>{step}</li>)}
            </ol>
          </div>
        ))
      }
    </div>

    <h3 class="font-semibold text-xl mb-5" style="color: var(--text-primary);">{it.routesTitle}</h3>
    <div class="grid gap-5 md:grid-cols-2">
      {
        routes.map((r) => (
          <div class="rounded-2xl p-6" style="background: var(--section-alt); border: 1px solid var(--border-color);">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl" aria-hidden="true">{r.icon}</span>
              <h4 class="font-semibold" style="color: var(--text-primary);">{r.title}</h4>
            </div>
            <p class="text-sm mb-3" style="color: var(--text-secondary);">{r.body}</p>
            <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
              {(r.items ?? []).map((item) => (
                <li class="flex items-start gap-2">
                  <span aria-hidden="true" style="color: var(--color-ocean-600, #0369a1);">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
