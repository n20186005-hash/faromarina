---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const a = messages.about;
const paragraphs = a.paragraphs ?? [];
---

<section id="about" class="section-shell">
  <div class="max-w-3xl mx-auto px-4 py-16 sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] mb-3" style="color: var(--color-ocean-600, #0369a1);">{messages.common.faroAlgarve}</p>
    <h2 class="font-display text-3xl sm:text-4xl font-bold mb-6" style="color: var(--text-primary);">{a.title}</h2>
    <div class="space-y-4 text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">
      {paragraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>
    {a.managedBy && (
      <div class="mt-6 rounded-xl px-4 py-3 text-sm" style="background: var(--color-ocean-50, #f0f9ff); border:1px solid var(--color-ocean-200, #bae6fd); color: var(--color-ocean-800, #0c4a6e);">
        🏛️ <span class="font-semibold">{a.managedBy}</span>
      </div>
    )}
  </div>
</section>
