---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const l = messages.legends;
const items = l.items ?? [];
const audio = l.audioTour ?? {};
---

<section id="legends" class="section-shell">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{l.title}</h2>
      {l.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{l.intro}</p>}
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {items.map((it) => (
        <div class="rounded-2xl p-6" style="background: var(--card-bg); border: 1px solid var(--border-color);">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl" aria-hidden="true">{it.emoji}</span>
            <h3 class="font-semibold text-lg" style="color: var(--text-primary);">{it.title}</h3>
          </div>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{it.text}</p>
        </div>
      ))}
    </div>

    {audio && audio.title && (
      <div class="mt-8 max-w-2xl mx-auto">
        <div class="audio-tour" role="button" aria-disabled="true" title={audio.note}>
          <span class="play" aria-hidden="true">🎧</span>
          <div>
            <p class="meta-title">{audio.title}</p>
            <p class="meta-sub">{audio.label}</p>
          </div>
          <span class="badge">{audio.note}</span>
        </div>
      </div>
    )}
  </div>
</section>
