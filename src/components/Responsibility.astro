---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const r = messages.responsibility;
const science = r.science ?? [];
const duty = r.duty ?? [];
---

<section id="responsibility" class="section-shell-alt">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{r.title}</h2>
      {r.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{r.intro}</p>}
    </div>

    <h3 class="font-semibold text-xl mb-5" style="color: var(--text-primary);">{r.scienceTitle}</h3>
    <div class="grid gap-5 md:grid-cols-3 mb-12">
      {
        science.map((s) => (
          <div class="rounded-2xl p-6" style="background: var(--card-bg); border: 1px solid var(--border-color);">
            <div class="text-3xl mb-3" aria-hidden="true">{s.emoji}</div>
            <h4 class="font-semibold mb-2" style="color: var(--text-primary);">{s.title}</h4>
            <p class="text-sm" style="color: var(--text-secondary);">{s.text}</p>
          </div>
        ))
      }
    </div>

    <div class="rounded-2xl p-6" style="background: var(--section-bg); border: 1px solid var(--border-color);">
      <h3 class="font-semibold text-xl mb-4" style="color: var(--text-primary);">{r.dutyTitle}</h3>
      <ul class="space-y-3 text-sm" style="color: var(--text-secondary);">
        {
          duty.map((d) => (
            <li class="flex items-start gap-2">
              <span aria-hidden="true" style="color: var(--color-ocean-600, #0369a1);">✓</span>
              <span>{d}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
