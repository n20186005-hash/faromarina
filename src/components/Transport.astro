---
import { getI18n } from '../i18n/ui';
import { poi } from '../data/poi';

const { lang, messages } = getI18n(Astro.url);
const t = messages.transport;
const mapsUrl = messages.mapsUrl ?? poi.mapsUrl;
const modes = t?.modes ?? [];
---

<section id="transport" class="section-shell">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{t.title}</h2>
      {t.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{t.intro}</p>}
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        modes.map((m) => (
          <div class="rounded-2xl p-6 flex flex-col" style="background: var(--card-bg); border: 1px solid var(--border-color);">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl" aria-hidden="true">{m.icon}</span>
              <h3 class="font-semibold text-lg" style="color: var(--text-primary);">{m.title}</h3>
            </div>
            <p class="text-sm mb-3" style="color: var(--text-secondary);">{m.body}</p>
            <ul class="mt-auto space-y-2">
              {(m.tips ?? []).map((tip) => (
                <li class="text-sm flex gap-2" style="color: var(--text-secondary);">
                  <span aria-hidden="true" style="color: var(--color-ocean-600, #0369a1);">✓</span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-cta btn-cta-primary">
        🗺️ {t.cta}
      </a>
    </div>
  </div>
</section>
