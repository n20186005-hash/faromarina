---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const s = messages.seasonal;
const cols = s.columns;
const rows = s.rows ?? [];
---

<section id="seasonal" class="section-shell-alt">
  <div class="max-w-5xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{s.title}</h2>
      {s.intro && <p class="mt-3 max-w-2xl mx-auto text-base sm:text-lg" style="color: var(--text-secondary);">{s.intro}</p>}
    </div>

    <div class="overflow-x-auto rounded-2xl" style="border: 1px solid var(--border-color);">
      <table class="w-full text-sm" style="border-collapse: collapse;">
        <thead>
          <tr style="background: var(--section-alt);">
            <th class="text-left p-3 align-top" style="color: var(--text-primary); font-semibold;">{cols.season}</th>
            <th class="text-left p-3 align-top" style="color: var(--text-primary); font-semibold;">{cols.weather}</th>
            <th class="text-left p-3 align-top" style="color: var(--text-primary); font-semibold;">{cols.water}</th>
            <th class="text-left p-3 align-top" style="color: var(--text-primary); font-semibold;">{cols.wildlife}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr style="border-top: 1px solid var(--border-color);">
                <td class="p-3 align-top" style="color: var(--text-primary); font-semibold; white-space: nowrap;">{r.season}</td>
                <td class="p-3 align-top" style="color: var(--text-secondary);">{r.weather}</td>
                <td class="p-3 align-top" style="color: var(--text-secondary);">{r.water}</td>
                <td class="p-3 align-top" style="color: var(--text-secondary);">{r.wildlife}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
