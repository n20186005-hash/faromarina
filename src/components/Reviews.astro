---
import { getI18n } from '../i18n/ui';
import { poi } from '../data/poi';

const { lang, messages } = getI18n(Astro.url);
const r = messages.reviews;
const likes = r.likes ?? [];
const tips = r.tips ?? [];
const reviewCount = poi.reviews.toLocaleString(lang === 'pt' ? 'pt-PT' : lang === 'zh' ? 'zh-CN' : 'en-US');
const mapsUrl = messages.mapsUrl ?? poi.mapsUrl;

// Layered star fill so fractional ratings (e.g. 4.4) render accurately.
const starPct = Math.max(0, Math.min(100, (poi.rating / 5) * 100));
---

<section id="reviews" class="section-shell-alt">
  <div class="max-w-4xl mx-auto px-4 py-16 sm:py-20">
    <div class="text-center mb-12">
      <h2 class="font-display text-3xl sm:text-4xl font-bold" style="color: var(--text-primary);">{r.title}</h2>
    </div>

    <div class="rounded-3xl p-8 text-center mb-4" style="background: var(--card-bg); border: 1px solid var(--border-color);">
      <div class="text-5xl font-display font-bold" style="color: var(--color-ocean-600, #0369a1);">{poi.rating}</div>
      <div class="relative inline-block text-2xl leading-none my-2" style="color: var(--text-muted);" aria-hidden="true">
        <span>★★★★★</span>
        <span class="absolute left-0 top-0 overflow-hidden whitespace-nowrap" style={`color:#fbbf24; width:${starPct}%;`}>★★★★★</span>
      </div>
      <p class="text-sm" style="color: var(--text-secondary);">{r.ratingLabel}: <strong>{poi.rating} / 5</strong> · {reviewCount} {r.reviewCountLabel}</p>

      <p class="mt-3 text-xs" style="color: var(--text-muted);">
        {r.sourcePrefix}<a href={mapsUrl} target="_blank" rel="noopener" style="color: var(--color-ocean-600, #0369a1); text-decoration: underline;">{r.sourceLinkLabel} ↗</a>
      </p>
    </div>

    <div class="rounded-2xl p-5 mb-8 text-sm flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3" style="background: var(--card-bg); border: 1px solid var(--border-color);">
      <p style="color: var(--text-secondary);">{r.sourceStatement}</p>
      <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-base flex-none" style="display:inline-flex; align-items:center; gap:.4rem; background: var(--color-ocean-600, #0369a1); color:#fff; padding:.55rem 1.1rem; border-radius:.6rem; font-weight:600;">
        🗺️ {r.sourceButton} ↗
      </a>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div class="rounded-2xl p-6" style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{r.likesTitle}</h3>
        <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
          {likes.map((l) => (
            <li class="flex items-start gap-2"><span style="color: var(--color-ocean-600, #0369a1);">✓</span><span>{l}</span></li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl p-6" style="background: var(--card-bg); border: 1px solid var(--border-color);">
        <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{r.tipsTitle}</h3>
        <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
          {tips.map((t) => (
            <li class="flex items-start gap-2"><span style="color: #d97706;">!</span><span>{t}</span></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 rounded-2xl p-6" style="background: var(--section-bg); border: 1px solid var(--border-color);">
      <h3 class="font-semibold mb-3" style="color: var(--text-primary);">{r.sourcesTitle}</h3>
      <ul class="space-y-2 text-sm" style="color: var(--text-secondary);">
        <li class="flex items-start gap-2"><span style="color: var(--color-ocean-600, #0369a1);">•</span><span>{r.sourcesReview}</span></li>
        <li class="flex items-start gap-2"><span style="color: var(--color-ocean-600, #0369a1);">•</span><span>{r.sourceStatement}</span></li>
        <li class="flex items-start gap-2"><span style="color: var(--color-ocean-600, #0369a1);">•</span><span><a href={mapsUrl} target="_blank" rel="noopener" style="color: var(--color-ocean-600, #0369a1); text-decoration: underline;">{r.sourceLinkLabel} ↗</a></span></li>
      </ul>
    </div>
  </div>
</section>
