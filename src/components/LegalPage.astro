---
import type { LegalDoc } from '../data/legal';

interface Props {
  doc: LegalDoc;
}
const { doc } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-12">
  <h1 class="text-3xl font-bold mb-1">{doc.title}</h1>
  <p class="text-sm opacity-70 mb-8">{doc.updated}</p>

  <div class="space-y-8">
    {
      doc.sections.map((s) => (
        <div>
          <h2 class="text-xl font-semibold mb-2">{s.heading}</h2>
          {s.paragraphs?.map((p) => (
            <p class="mb-2 leading-relaxed opacity-90">{p}</p>
          ))}
          {s.list && (
            <ul class="list-disc pl-6 space-y-1 opacity-90">
              {s.list.map((li) => (
                <li>{li}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>

  {
    doc.buttons && (
      <div class="flex flex-wrap gap-3 mt-8">
        {doc.buttons.map((b) => (
          <button
            type="button"
            class="rounded-lg px-4 py-2 text-sm font-medium"
            style="background: var(--primary); color:#fff;"
          >
            {b}
          </button>
        ))}
      </div>
    )
  }
</section>
